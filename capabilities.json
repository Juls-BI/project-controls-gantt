{
    "privileges": [],
    "supportsKeyboardFocus": true,
    "supportsLandingPage": true,
    "supportsEmptyDataView": true,
    "supportsMultiVisualSelection": true,
    "tooltips": {
        "supportedTypes": {
            "default": true,
            "canvas": true
        },
        "roles": [
            "tooltipFields"
        ]
    },
    "dataRoles": [
        {
            "name": "taskId",
            "displayName": "Task ID",
            "description": "Unique task identifier. Must be a text column so letters and leading zeros are preserved.",
            "kind": "Grouping",
            "requiredTypes": [
                {
                    "text": true
                }
            ]
        },
        {
            "name": "taskName",
            "displayName": "Task name",
            "kind": "Grouping",
            "requiredTypes": [
                {
                    "text": true
                }
            ]
        },
        {
            "name": "itemType",
            "displayName": "Item or activity type",
            "description": "Optional. Text such as Task, Milestone, or a P6 Activity Type. Rows containing the word Milestone (or the word set in the format pane) are drawn as diamonds.",
            "kind": "Grouping",
            "requiredTypes": [
                {
                    "text": true
                }
            ]
        },
        {
            "name": "baselineStart",
            "displayName": "Baseline start",
            "kind": "Grouping",
            "description": "Date column. Leave as a date so Power BI does not build a date hierarchy."
        },
        {
            "name": "baselineFinish",
            "displayName": "Baseline finish",
            "kind": "Grouping",
            "description": "Date column. Leave as a date so Power BI does not build a date hierarchy."
        },
        {
            "name": "plannedStart",
            "displayName": "Planned start",
            "kind": "Grouping",
            "description": "Planned (forecast) start date. Actual dates up to the cut-off and planned dates after it are both fine. Shown in the grid as Planned start."
        },
        {
            "name": "plannedFinish",
            "displayName": "Planned finish",
            "kind": "Grouping",
            "description": "Planned (forecast) finish date. Actual dates up to the cut-off and planned dates after it are both fine. Shown in the grid as Planned finish."
        },
        {
            "name": "cutoffDate",
            "displayName": "Report cut-off date",
            "description": "Optional. The reporting cut-off or data date. Use a date column such as DataDate, or a measure such as MAX(Settings[Cut-off]). Draws the cut-off line and marks earlier planned dates as actual.",
            "kind": "GroupingOrMeasure"
        },
        {
            "name": "holidays",
            "displayName": "Holidays",
            "description": "Optional measure that lists holiday dates as text, for example CONCATENATEX ( Holidays, FORMAT ( Holidays[Date], \"yyyy-mm-dd\" ), \",\" ). Used when delay is counted in working days.",
            "kind": "Measure"
        },
        {
            "name": "percentComplete",
            "displayName": "Percent complete",
            "description": "A column or measure on a 0 to 1 or 0 to 100 scale. Text such as 45% also works. Use Don't summarize for a column.",
            "kind": "GroupingOrMeasure"
        },
        {
            "name": "predecessors",
            "displayName": "Predecessors",
            "description": "Text cell with comma separated Task IDs.",
            "kind": "Grouping",
            "requiredTypes": [
                {
                    "text": true
                }
            ]
        },
        {
            "name": "successors",
            "displayName": "Successors",
            "description": "Text cell with comma separated Task IDs.",
            "kind": "Grouping",
            "requiredTypes": [
                {
                    "text": true
                }
            ]
        },
        {
            "name": "totalFloat",
            "displayName": "Total float (days)",
            "description": "Optional. When supplied, float of zero or less is treated as critical.",
            "kind": "GroupingOrMeasure"
        },
        {
            "name": "extraColumns",
            "displayName": "Columns",
            "description": "Optional. Extra fields such as Owner or Status, shown on task rows only and left blank on group rows.",
            "kind": "Grouping"
        },
        {
            "name": "group",
            "displayName": "Group by",
            "description": "Optional. Up to six fields, outermost first, for example Project then Phase. Each level becomes a collapsible group.",
            "kind": "Grouping",
            "requiredTypes": [
                {
                    "text": true
                }
            ]
        },
        {
            "name": "tooltipFields",
            "displayName": "Tooltips",
            "description": "Optional. Extra columns or measures shown only in the tooltip.",
            "kind": "GroupingOrMeasure"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "taskId": {
                        "min": 1,
                        "max": 1
                    },
                    "taskName": {
                        "max": 1
                    },
                    "baselineStart": {
                        "max": 1
                    },
                    "baselineFinish": {
                        "max": 1
                    },
                    "plannedStart": {
                        "max": 1
                    },
                    "plannedFinish": {
                        "max": 1
                    },
                    "percentComplete": {
                        "max": 1
                    },
                    "predecessors": {
                        "max": 1
                    },
                    "successors": {
                        "max": 1
                    },
                    "totalFloat": {
                        "max": 1
                    },
                    "group": {
                        "max": 6
                    },
                    "cutoffDate": {
                        "max": 1
                    },
                    "extraColumns": {
                        "max": 8
                    },
                    "itemType": {
                        "max": 1
                    },
                    "tooltipFields": {
                        "max": 10
                    },
                    "holidays": {
                        "max": 1
                    }
                }
            ],
            "table": {
                "rows": {
                    "select": [
                        {
                            "for": {
                                "in": "taskId"
                            }
                        },
                        {
                            "for": {
                                "in": "taskName"
                            }
                        },
                        {
                            "for": {
                                "in": "itemType"
                            }
                        },
                        {
                            "for": {
                                "in": "baselineStart"
                            }
                        },
                        {
                            "for": {
                                "in": "baselineFinish"
                            }
                        },
                        {
                            "for": {
                                "in": "plannedStart"
                            }
                        },
                        {
                            "for": {
                                "in": "plannedFinish"
                            }
                        },
                        {
                            "for": {
                                "in": "cutoffDate"
                            }
                        },
                        {
                            "for": {
                                "in": "holidays"
                            }
                        },
                        {
                            "for": {
                                "in": "percentComplete"
                            }
                        },
                        {
                            "for": {
                                "in": "predecessors"
                            }
                        },
                        {
                            "for": {
                                "in": "successors"
                            }
                        },
                        {
                            "for": {
                                "in": "totalFloat"
                            }
                        },
                        {
                            "for": {
                                "in": "extraColumns"
                            }
                        },
                        {
                            "for": {
                                "in": "group"
                            }
                        },
                        {
                            "for": {
                                "in": "tooltipFields"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "window": {
                            "count": 30000
                        }
                    }
                }
            }
        }
    ],
